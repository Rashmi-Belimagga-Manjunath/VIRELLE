# VIRELLE backend configuration
# At least one LLM key is required to run operations.

# --- LLM providers (set at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
# VIRELLE_MODEL=
# VIRELLE_OPENAI_MODEL=gpt-4o
# VIRELLE_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Optional: Fáilte Ireland Events subscription key ---
# The free Open Data feed shares a bandwidth quota. Subscribing to the free
# "Open Data Plus" product at https://failteireland.developer.azure-api.net
# removes the limit. Paste your subscription key below to always fetch live.
# VIRELLE_EVENTS_API_KEY=

# --- Optional: Google Sheet (live spreadsheet data source) ---
# Paste the published CSV URL of your Google Sheet here.
# The sheet should contain tabs for: Hotel, Rooms, Inventory, Packages, Facilities, Historical.
# To get the URL: Google Sheets → File → Share → Publish to web → select tab → CSV format → copy link.
# VIRELLE_GOOGLE_SHEET_URL=
